# Copy this file to .env on the Raspberry Pi and replace the placeholder values.
# Do not commit real TURN credentials.

# WebRTC ICE servers used by the Pi when connecting to the ML service.
# The ML service on Render must be configured with the same value.
# Expected schema: JSON array of objects with "urls", plus optional "username"
# and "credential". Use "urls", not "url".
#
# Metered often provides several URLs. Keep them in one "urls" list when they
# share credentials. This should match the value configured on Render.
WEBRTC_ICE_SERVERS='[{"urls":["stun:YOUR_METERED_DOMAIN:80","turn:YOUR_METERED_DOMAIN:80","turn:YOUR_METERED_DOMAIN:443","turns:YOUR_METERED_DOMAIN:443"],"username":"YOUR_METERED_USERNAME","credential":"YOUR_METERED_CREDENTIAL"}]'

# Run with:
# python3 firmware.py
